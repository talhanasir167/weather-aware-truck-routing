DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Free truck routing (recommended for scoring):
# 1. Sign up at https://openrouteservice.org/dev/#/signup
# 2. Create a token and paste it below
# Without this key the app uses public OSRM + via-point alternatives.
ORS_API_KEY=

# Optional — defaults to locmem cache if unset
REDIS_URL=redis://127.0.0.1:6379/0

# Optional Postgres (defaults to sqlite)
# DATABASE_URL=postgres://spotter:spotter@127.0.0.1:5432/spotter

WIND_METRIC=sustained
VITE_API_BASE_URL=http://127.0.0.1:8000
